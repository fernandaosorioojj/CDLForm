QWidget#seleccionOperarioView {
    background-color: $bg_app;
}

QWidget#seleccionOperarioView QLabel[role="title"] {
    color: $text_heading;
}

QWidget#seleccionOperarioView QLabel[role="subtitle"] {
    color: $text_secondary;
}

QWidget#seleccionOperarioView QFrame#infoFormularioSeleccion,
QWidget#seleccionOperarioView QFrame#selectorOperario {
    min-width: 720px;
}

QWidget#seleccionOperarioView QFrame#infoFormularioSeleccion QLabel[role="field-label"] {
    color: $text_secondary;
    font-weight: 600;
}

QWidget#seleccionOperarioView QFrame#infoFormularioSeleccion QLabel[role="field-value"] {
    color: $text_primary;
    font-weight: 600;
}

QWidget#seleccionOperarioView QLabel[role="inline-warning"] {
    color: $border_warning;
    font-weight: 600;
}

QWidget#seleccionOperarioView QFrame[compactCard="true"] {
    background-color: $bg_card;
    border: 1px solid $border;
    border-radius: ${radius_md}px;
    padding: 8px;
}

QWidget#seleccionOperarioView QFrame[compactCard="true"] QLabel[role="section"] {
    color: $text_heading;
    font-size: ${font_size_base}px;
    padding: 2px 0 6px 0;
}

QWidget#seleccionOperarioView QListWidget {
    background-color: $bg_input;
    border: 1px solid $border_input;
    border-radius: ${radius_sm}px;
    min-height: 190px;
    max-height: 260px;
}

QWidget#seleccionOperarioView QListWidget::item {
    border-bottom: 1px solid $border;
    color: $text_primary;
    padding: 10px 8px;
}

QWidget#seleccionOperarioView QListWidget::item:hover {
    background-color: $bg_button_secondary_hover;
    color: $text_heading;
}

QWidget#seleccionOperarioView QListWidget::item:selected {
    background-color: $bg_button;
    color: $text_on_button;
}
