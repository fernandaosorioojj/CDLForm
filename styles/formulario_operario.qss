QWidget#formularioOperarioView {
    background-color: $bg_app;
}

QWidget#formularioOperarioView QScrollArea#preguntasScroll {
    background-color: transparent;
    border: none;
}

QWidget#formularioOperarioView QWidget#contenedorPreguntas {
    background-color: transparent;
}

QWidget#formularioOperarioView QFrame#infoFormulario,
QWidget#formularioOperarioView QFrame#observacionFormulario,
QWidget#formularioOperarioView QFrame[questionCard="true"] {
    background-color: $bg_card;
    border: 1px solid $border;
    border-radius: ${radius_lg}px;
}

QWidget#formularioOperarioView QFrame#infoFormulario {
    max-height: 150px;
}

QWidget#formularioOperarioView QFrame#observacionFormulario {
    max-height: 150px;
}

QWidget#formularioOperarioView QFrame#infoFormulario QLabel,
QWidget#formularioOperarioView QFrame#observacionFormulario QLabel,
QWidget#formularioOperarioView QFrame[questionCard="true"] QLabel {
    color: $text_primary;
}

QWidget#formularioOperarioView QFrame#observacionFormulario QLabel[role="section"],
QWidget#formularioOperarioView QFrame[questionCard="true"] QLabel[role="question"] {
    color: $text_heading;
}

QWidget#formularioOperarioView QFrame#infoFormulario QLabel[role="field-label"] {
    color: $text_secondary;
    font-weight: 600;
}

QWidget#formularioOperarioView QFrame#infoFormulario QLabel[role="field-value"] {
    color: $text_primary;
    font-weight: 600;
}

QWidget#formularioOperarioView QLabel[role="question"] {
    color: $text_heading;
    font-weight: 700;
}

QWidget#formularioOperarioView QLabel[role="inline-warning"] {
    color: $border_warning;
    font-weight: 600;
}

QWidget#formularioOperarioView QCheckBox {
    padding: 4px 0;
}

QWidget#formularioOperarioView QWidget#opcionesMultiples {
    background-color: #f7fbf8;
    border: 1px solid $border;
    border-radius: ${radius_lg}px;
}

QWidget#formularioOperarioView QWidget#opcionesMultiples QCheckBox[optionChoice="true"] {
    background-color: $bg_card;
    border: 1px solid $border_input;
    border-radius: ${radius_sm}px;
    color: $text_primary;
    font-weight: 600;
    min-height: 24px;
    padding: 10px 12px;
}

QWidget#formularioOperarioView QWidget#opcionesMultiples QCheckBox[optionChoice="true"]:hover {
    border-color: $bg_button_secondary;
    background-color: #f1faf6;
}

QWidget#formularioOperarioView QWidget#opcionesMultiples QCheckBox[optionChoice="true"]:checked {
    border: 2px solid $bg_button;
    background-color: #e9f8eb;
    color: $text_heading;
}

QWidget#formularioOperarioView QWidget#opcionesMultiples QCheckBox[optionChoice="true"]::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid $border_input;
    border-radius: 5px;
    background-color: $bg_card;
}

QWidget#formularioOperarioView QWidget#opcionesMultiples QCheckBox[optionChoice="true"]::indicator:checked {
    background-color: $bg_button;
    border: 1px solid $bg_button;
}

QWidget#formularioOperarioView QRadioButton {
    color: $text_primary;
    padding: 4px 12px 4px 0;
}

QWidget#formularioOperarioView QPushButton {
    min-width: 120px;
}
