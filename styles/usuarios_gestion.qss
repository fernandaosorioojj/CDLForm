QWidget#usuariosGestionView {
    background-color: #FFFFFF;
}

QWidget#usuariosGestionView QFrame#usuariosTopPanel {
    background-color: #05095C;
    border: 1px solid rgba(5, 9, 92, 220);
    border-radius: 18px;
}

QWidget#usuariosGestionView QFrame#usuariosHeader {
    background-color: transparent;
    border: none;
}

QWidget#usuariosGestionView QFrame#usuariosHeader QLabel[role="title"] {
    color: #FFFFFF;
    font-size: 30px;
}

QWidget#usuariosGestionView QFrame#usuariosHeader QLabel[role="subtitle"] {
    color: rgba(255, 255, 255, 0.72);
    font-size: 15px;
}

QWidget#usuariosGestionView QFrame#usuariosHeader QLabel[role="eyebrow"] {
    color: rgba(255, 255, 255, 0.56);
}

QWidget#usuariosGestionView QFrame[card="true"] {
    background-color: rgba(255, 255, 255, 248);
    border: 1px solid rgba(154, 179, 230, 220);
    border-radius: 12px;
}

QWidget#usuariosGestionView QLabel[role="section"] {
    color: #05095C;
    font-size: 18px;
    font-weight: 800;
}

QWidget#usuariosGestionView QLabel[role="subtitle"] {
    color: #8F8F8F;
    font-size: 13px;
}

QWidget#usuariosGestionView QPushButton {
    background-color: #05095C;
    color: #FFFFFF;
    border: 1px solid #05095C;
}

QWidget#usuariosGestionView QPushButton:hover {
    background-color: #05095C;
    border: 1px solid #05095C;
}

QWidget#usuariosGestionView QPushButton[variant="secondary"] {
    background-color: #9AB3E6;
    color: #05095C;
    border: 1px solid rgba(154, 179, 230, 0.95);
}

QWidget#usuariosGestionView QPushButton[variant="secondary"]:hover {
    background-color: #FFFFFF;
}

QWidget#usuariosGestionView QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid rgba(154, 179, 230, 220);
    border-radius: 8px;
}

