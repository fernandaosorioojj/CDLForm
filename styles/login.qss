QWidget#loginView {
    background-color: $bg_app;
}

QWidget#loginView QFrame[card="true"] {
    min-width: 360px;
}

QWidget#loginView QFrame#loginShell {
    background-color: transparent;
    border: none;
}

QWidget#loginView QFrame#loginVisual {
    min-width: 300px;
}

QWidget#loginView QLineEdit {
    min-height: 20px;
}
