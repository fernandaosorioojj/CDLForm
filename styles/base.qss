QWidget {
    background-color: $bg_app;
    color: $text_on_app;
    font-family: "$font_family";
    font-size: ${font_size_base}px;
}

QWidget[animatedBackground="true"] {
    background-color: transparent;
}

QLabel {
    background: transparent;
    color: $text_on_app;
}

QLabel[role="title"] {
    color: $text_on_app;
    font-size: ${font_size_title}px;
    font-weight: 700;
    padding: 2px 0 6px 0;
}

QLabel[role="subtitle"] {
    color: $text_on_app_accent;
    font-size: ${font_size_base}px;
    padding-bottom: 8px;
}

QLabel[role="eyebrow"] {
    color: $focus;
    font-size: 12px;
    font-weight: 700;
    padding: 0;
    text-transform: uppercase;
}

QLabel[role="section"] {
    color: $text_on_app_accent;
    font-size: ${font_size_section}px;
    font-weight: 700;
    padding: 6px 0;
}

QFrame {
    background-color: transparent;
    border: none;
}

QFrame[card="true"] {
    background-color: $bg_card;
    border: 1px solid $border;
    border-radius: ${radius_lg}px;
    padding: 12px;
}

QFrame[visualPanel="true"] {
    background-color: $bg_button;
    border: 1px solid $bg_button;
    border-radius: ${radius_lg}px;
    padding: 14px;
}

QFrame[visualPanel="true"] QLabel {
    color: $text_on_button;
}

QFrame[visualPanel="true"] QLabel[role="subtitle"] {
    color: #7a86a0;
}

QLabel[assetImage="true"] {
    background-color: transparent;
    border: none;
}

QFrame[card="true"] QLabel {
    color: $text_primary;
}

QFrame[card="true"] QLabel[role="title"],
QFrame[card="true"] QLabel[role="section"] {
    color: $text_heading;
}

QFrame[card="true"] QLabel[role="subtitle"] {
    color: $text_secondary;
}

QFrame[card="true"] QFrame[visualPanel="true"] QLabel,
QFrame[visualPanel="true"] QLabel {
    color: $text_on_button;
}

QFrame[card="true"] QFrame[visualPanel="true"] QLabel[role="title"],
QFrame[card="true"] QFrame[visualPanel="true"] QLabel[role="section"],
QFrame[visualPanel="true"] QLabel[role="title"],
QFrame[visualPanel="true"] QLabel[role="section"] {
    color: $text_on_button;
}

QFrame[card="true"] QFrame[visualPanel="true"] QLabel[role="subtitle"],
QFrame[visualPanel="true"] QLabel[role="subtitle"] {
    color: #7a86a0;
}

QFrame[card="true"] QLabel[role="field-label"] {
    color: $text_secondary;
    font-weight: 600;
}

QFrame[card="true"] QLabel[role="field-value"] {
    color: $text_primary;
    font-weight: 600;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox {
    background-color: $bg_input;
    border: 1px solid $border_input;
    border-radius: ${radius_sm}px;
    padding: 10px 12px;
    color: $text_primary;
    selection-background-color: $bg_button_secondary_hover;
}

QLineEdit QLabel,
QComboBox QLabel,
QSpinBox QLabel {
    color: $text_primary;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus {
    border: 2px solid $focus;
    background-color: #F9FBFF;
}

QComboBox {
    padding-right: 28px;
    color: $text_primary;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: $bg_card;
    border: 1px solid $border_input;
    color: $text_primary;
    selection-background-color: $bg_button;
    selection-color: $text_on_button;
    outline: 0;
}

QComboBox QAbstractItemView::item {
    background-color: $bg_card;
    color: $text_primary;
    min-height: 28px;
    padding: 6px 10px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: $bg_button_secondary_hover;
    color: $text_on_button;
}

QPushButton {
    background-color: $bg_button;
    color: $text_on_button;
    border: 1px solid $bg_button;
    border-radius: ${radius_sm}px;
    padding: 11px 20px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton:hover {
    background-color: $bg_button_hover;
    border: 1px solid $bg_button_hover;
}

QPushButton:pressed {
    background-color: #C5C5C5;
    border: 1px solid #C5C5C5;
}

QPushButton:disabled {
    background-color: $border_input;
    border: 1px solid $border_input;
    color: $text_on_button;
}

QPushButton[variant="secondary"] {
    background-color: $bg_button_secondary;
    color: $text_heading;
    border: 1px solid #D3D9DF;
}

QPushButton[variant="secondary"]:hover {
    background-color: $bg_button_secondary_hover;
    border: 1px solid $bg_button_secondary_hover;
}

QPushButton[variant="success"] {
    background-color: $bg_button_success;
    border: 1px solid $bg_button_success;
    color: #4F6278;
}

QPushButton[variant="success"]:hover {
    background-color: $bg_button_success_hover;
    border: 1px solid $bg_button_success_hover;
}

QPushButton[variant="danger"] {
    background-color: $bg_button_danger;
    border: 1px solid $bg_button_danger;
    color: $text_on_button;
}

QPushButton[variant="danger"]:hover {
    background-color: $bg_button_danger_hover;
    border: 1px solid $bg_button_danger_hover;
}

QTableWidget,
QTableView,
QTreeWidget,
QListWidget {
    background-color: $bg_card;
    border: 1px solid $border;
    border-radius: ${radius_md}px;
    color: $text_primary;
    outline: 0;
    gridline-color: $border;
    alternate-background-color: #F7F9FC;
}

QHeaderView::section {
    background-color: $bg_button_secondary;
    color: $text_heading;
    border: none;
    border-bottom: 1px solid $border;
    padding: 8px;
    font-weight: 700;
}

QListWidget::item {
    border-bottom: 1px solid $border;
    padding: 8px 6px;
}

QListWidget::item:hover {
    background-color: $bg_button_secondary_hover;
}

QTableWidget::item:selected,
QTableView::item:selected,
QTreeWidget::item:selected,
QListWidget::item:selected {
    background-color: $bg_button;
    color: $text_on_button;
}

QCheckBox,
QRadioButton {
    spacing: 8px;
    color: $text_primary;
}

QScrollArea {
    border: none;
    background-color: transparent;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}
