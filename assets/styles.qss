/* ===== base global ===== */

QWidget {
    background-color: #f4f7fb;
    color: #1f2a37;
    font-family: "Segoe UI";
    font-size: 14px;
}

QMainWindow,
QDialog,
QScrollArea,
QScrollArea > QWidget > QWidget {
    background-color: #f4f7fb;
}

/* ===== textos ===== */

QLabel {
    background: transparent;
    color: #1f2a37;
}

QLabel[role="title"] {
    color: #0f2747;
    font-size: 26px;
    font-weight: 700;
    padding: 8px 0;
}

QLabel[role="subtitle"] {
    color: #4b5b70;
    font-size: 14px;
    padding-bottom: 10px;
}

QLabel[role="section"] {
    color: #0f2747;
    font-size: 18px;
    font-weight: 700;
    padding: 6px 0;
}

/* ===== contenedores ===== */

QFrame {
    background-color: #ffffff;
    border: 1px solid #d8e1ec;
    border-radius: 12px;
}

QFrame[card="true"] {
    background-color: #ffffff;
    border: 1px solid #d8e1ec;
    border-radius: 14px;
    padding: 8px;
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d8e1ec;
    border-radius: 12px;
    margin-top: 14px;
    padding: 16px 12px 12px 12px;
    font-weight: 700;
    color: #0f2747;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #0f2747;
}

/* ===== entradas ===== */

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit {
    background-color: #ffffff;
    border: 1px solid #c9d5e4;
    border-radius: 10px;
    padding: 10px 12px;
    color: #1f2a37;
    selection-background-color: #4da3ff;
    selection-color: #ffffff;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDateEdit:focus,
QTimeEdit:focus,
QDateTimeEdit:focus {
    border: 2px solid #4da3ff;
    background-color: #fdfefe;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled {
    background-color: #edf2f7;
    color: #7b8794;
    border: 1px solid #d6dee8;
}

QTextEdit,
QPlainTextEdit {
    padding-top: 10px;
}

QComboBox {
    padding-right: 28px;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
    margin-right: 6px;
}

QComboBox::down-arrow {
    width: 10px;
    height: 10px;
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #5a6a7f;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #c9d5e4;
    selection-background-color: #d9ecff;
    selection-color: #0f2747;
    outline: 0;
}

QSpinBox::up-button,
QSpinBox::down-button {
    width: 20px;
    border: none;
    background: transparent;
}

QSpinBox::up-arrow,
QSpinBox::down-arrow {
    width: 8px;
    height: 8px;
}

/* ===== botones ===== */

QPushButton {
    background-color: #12345a;
    color: #ffffff;
    border: 1px solid #12345a;
    border-radius: 10px;
    padding: 10px 18px;
    font-weight: 600;
    min-height: 18px;
}

QPushButton:hover {
    background-color: #184679;
    border: 1px solid #184679;
}

QPushButton:pressed {
    background-color: #0d2744;
    border: 1px solid #0d2744;
}

QPushButton:disabled {
    background-color: #b7c4d3;
    border: 1px solid #b7c4d3;
    color: #eef3f8;
}

QPushButton[variant="secondary"] {
    background-color: #e8f2fc;
    color: #12345a;
    border: 1px solid #bfd7ef;
}

QPushButton[variant="secondary"]:hover {
    background-color: #d9ecff;
    border: 1px solid #9dc7ef;
}

QPushButton[variant="success"] {
    background-color: #1f7a5c;
    border: 1px solid #1f7a5c;
    color: #ffffff;
}

QPushButton[variant="success"]:hover {
    background-color: #268d6b;
    border: 1px solid #268d6b;
}

QPushButton[variant="danger"] {
    background-color: #b54141;
    border: 1px solid #b54141;
    color: #ffffff;
}

QPushButton[variant="danger"]:hover {
    background-color: #c55353;
    border: 1px solid #c55353;
}

/* ===== tablas ===== */

QTableWidget,
QTableView,
QTreeWidget,
QListWidget {
    background-color: #ffffff;
    alternate-background-color: #f7fbff;
    border: 1px solid #d8e1ec;
    border-radius: 12px;
    gridline-color: #e4ebf3;
    color: #1f2a37;
    outline: 0;
}

QHeaderView::section {
    background-color: #12345a;
    color: #ffffff;
    border: none;
    padding: 10px 8px;
    font-weight: 700;
}

QTableWidget::item,
QTableView::item,
QTreeWidget::item,
QListWidget::item {
    padding: 8px;
}

QTableWidget::item:selected,
QTableView::item:selected,
QTreeWidget::item:selected,
QListWidget::item:selected {
    background-color: #d9ecff;
    color: #0f2747;
}

/* ===== barras de scroll ===== */

QScrollBar:vertical {
    background: #eaf0f7;
    width: 12px;
    margin: 2px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #a6b8cc;
    min-height: 30px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #8ea6bf;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
    border: none;
}

QScrollBar:horizontal {
    background: #eaf0f7;
    height: 12px;
    margin: 2px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: #a6b8cc;
    min-width: 30px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background: #8ea6bf;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
    border: none;
}

/* ===== pestañas ===== */

QTabWidget::pane {
    border: 1px solid #d8e1ec;
    background-color: #ffffff;
    border-radius: 12px;
    top: -1px;
}

QTabBar::tab {
    background: #dfe9f4;
    color: #36506b;
    border: 1px solid #cbd7e4;
    padding: 10px 16px;
    margin-right: 4px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background: #12345a;
    color: #ffffff;
    border: 1px solid #12345a;
}

QTabBar::tab:hover:!selected {
    background: #e9f3fc;
    color: #12345a;
}

/* ===== checkbox y radio ===== */

QCheckBox,
QRadioButton {
    spacing: 8px;
    color: #1f2a37;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 18px;
    height: 18px;
}

QCheckBox::indicator:unchecked,
QRadioButton::indicator:unchecked {
    background-color: #ffffff;
    border: 1px solid #b8c7d8;
    border-radius: 4px;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #4da3ff;
    border: 1px solid #4da3ff;
    border-radius: 4px;
}

/* ===== mensajes ===== */

QMessageBox {
    background-color: #f4f7fb;
}

QMessageBox QLabel {
    color: #1f2a37;
    font-size: 14px;
}

QMessageBox QPushButton {
    min-width: 90px;
}

/* ===== menús ===== */

QMenuBar {
    background-color: #12345a;
    color: #ffffff;
}

QMenuBar::item {
    background: transparent;
    padding: 8px 12px;
}

QMenuBar::item:selected {
    background-color: #184679;
    border-radius: 6px;
}

QMenu {
    background-color: #ffffff;
    border: 1px solid #d8e1ec;
    padding: 6px;
}

QMenu::item {
    padding: 8px 18px;
    border-radius: 6px;
    color: #1f2a37;
}

QMenu::item:selected {
    background-color: #d9ecff;
    color: #0f2747;
}