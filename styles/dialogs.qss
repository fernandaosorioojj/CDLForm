QDialog#accionCorrectivaDialog,
QDialog#confirmacionEnvioDialog {
    background-color: $bg_app;
}

QDialog#accionCorrectivaDialog QFrame#dialogCard,
QDialog#confirmacionEnvioDialog QFrame#dialogCard {
    background-color: $bg_card;
    border: 1px solid $border;
    border-radius: ${radius_lg}px;
}

QDialog#accionCorrectivaDialog QFrame#dialogCard QLabel,
QDialog#confirmacionEnvioDialog QFrame#dialogCard QLabel {
    color: $text_primary;
}

QDialog#accionCorrectivaDialog QLabel[role="dialog-title"],
QDialog#confirmacionEnvioDialog QLabel[role="dialog-title"] {
    color: $text_heading;
    font-size: ${font_size_section}px;
    font-weight: 700;
}

QDialog#accionCorrectivaDialog QLabel[role="dialog-text"],
QDialog#confirmacionEnvioDialog QLabel[role="dialog-text"] {
    color: $text_secondary;
}

QDialog#accionCorrectivaDialog QFrame#accionCorrectivaBox {
    background-color: $bg_warning_soft;
    border: 1px solid $border_warning;
    border-radius: ${radius_md}px;
}

QDialog#accionCorrectivaDialog QFrame#accionCorrectivaBox QLabel {
    color: $text_primary;
    font-weight: 600;
}

QDialog#confirmacionEnvioDialog QCheckBox#confirmacionCheck {
    background-color: #FFFFFF;
    border: 1px solid $border;
    border-radius: ${radius_sm}px;
    color: $text_primary;
    font-weight: 600;
    padding: 10px 12px;
}

QDialog#confirmacionEnvioDialog QCheckBox#confirmacionCheck::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid $border_input;
    border-radius: 5px;
    background-color: $bg_card;
}

QDialog#confirmacionEnvioDialog QCheckBox#confirmacionCheck::indicator:checked {
    background-color: $bg_button;
    border: 1px solid $bg_button;
}

