QWidget#accionesCorrectivasView {
    background-color: #FFFFFF;
}

QWidget#accionesCorrectivasView QFrame#accionesTopPanel {
    background-color: #05095C;
    border: 1px solid rgba(5, 9, 92, 220);
    border-radius: 18px;
}

QWidget#accionesCorrectivasView QFrame#accionesHeader {
    background-color: transparent;
    border: none;
}

QWidget#accionesCorrectivasView QFrame#accionesHeader QLabel[role="title"] {
    color: #FFFFFF;
    font-size: 30px;
}

QWidget#accionesCorrectivasView QFrame#accionesHeader QLabel[role="subtitle"] {
    color: rgba(255, 255, 255, 0.72);
    font-size: 15px;
}

QWidget#accionesCorrectivasView QFrame#accionesHeader QLabel[role="eyebrow"] {
    color: rgba(255, 255, 255, 0.56);
}

QWidget#accionesCorrectivasView QFrame[card="true"] {
    padding: 12px;
    background-color: rgba(255, 255, 255, 244);
    border: 1px solid rgba(154, 179, 230, 232);
    border-radius: 18px;
}

QWidget#accionesCorrectivasView QLabel[role="title"] {
    color: #05095C;
}

QWidget#accionesCorrectivasView QLabel[role="subtitle"] {
    color: #8F8F8F;
}

QWidget#accionesCorrectivasView QPushButton {
    background-color: #05095C;
    color: #FFFFFF;
    border: 1px solid #05095C;
}

QWidget#accionesCorrectivasView QPushButton:hover {
    background-color: #05095C;
    border: 1px solid #05095C;
}

QWidget#accionesCorrectivasView QPushButton[variant="secondary"] {
    background-color: #9AB3E6;
    color: #05095C;
    border: 1px solid rgba(154, 179, 230, 0.95);
}

QWidget#accionesCorrectivasView QPushButton[variant="secondary"]:hover {
    background-color: #FFFFFF;
    border: 1px solid rgba(154, 179, 230, 1);
}

QWidget#accionesCorrectivasView QTableWidget::item {
    min-height: 28px;
}

QWidget#accionesCorrectivasView QTableWidget {
    background-color: rgba(255, 255, 255, 252);
    border: 1px solid rgba(154, 179, 230, 220);
    border-radius: 14px;
}

QWidget#accionesCorrectivasView QHeaderView::section {
    background-color: #9AB3E6;
    color: #05095C;
    border-bottom: 1px solid rgba(154, 179, 230, 0.95);
    padding: 10px 8px;
}

