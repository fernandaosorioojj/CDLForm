QWidget#dashboardGestionView {
    background-color: transparent;
}

QFrame#dashboardSidePanel {
    background-color: #05095C;
    border: 1px solid rgba(5, 9, 92, 220);
    border-radius: ${radius_lg}px;
}

QLabel#dashboardSidebarBrand {
    color: #FFFFFF;
    font-size: 26px;
    font-weight: 800;
    letter-spacing: 0;
}

QLabel#dashboardSidebarSubtitle {
    color: rgba(255, 255, 255, 0.66);
    font-size: 13px;
    margin-bottom: 12px;
}

QPushButton#dashboardNavButton {
    background-color: rgba(255, 255, 255, 0);
    color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(255, 255, 255, 0);
    border-radius: ${radius_md}px;
    padding: 14px 12px;
    text-align: left;
    font-size: 12px;
    font-weight: 700;
}

QPushButton#dashboardNavButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.06);
}

QPushButton#dashboardNavButton[active="true"] {
    background-color: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #FFFFFF;
}

QFrame#dashboardHero {
    background-color: rgba(255, 255, 255, 248);
    border: 1px solid rgba(154, 179, 230, 220);
    border-radius: ${radius_lg}px;
}

QLabel#dashboardEyebrow {
    color: #05095C;
    font-size: 12px;
    font-weight: 700;
}

QLabel#dashboardHeroTitle {
    color: #05095C;
    font-size: 34px;
    font-weight: 800;
}

QLabel#dashboardHeroSubtitle {
    color: #8F8F8F;
    font-size: 15px;
}

QPushButton#dashboardPrimaryAction {
    background-color: #05095C;
    color: #FFFFFF;
    border: 1px solid #05095C;
    padding: 11px 18px;
    font-weight: 700;
}

QPushButton#dashboardPrimaryAction:hover {
    background-color: #05095C;
    border: 1px solid #05095C;
}

QPushButton#dashboardSecondaryAction {
    background-color: rgba(154, 179, 230, 0.9);
    color: #05095C;
    border: 1px solid rgba(154, 179, 230, 0.95);
}

QPushButton#dashboardSecondaryAction:hover {
    background-color: rgba(232, 211, 79, 0.28);
    border: 1px solid rgba(154, 179, 230, 1);
}

QLabel#dashboardHeroVisual {
    background-color: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(154, 179, 230, 0.92);
    border-radius: ${radius_lg}px;
    padding: 12px;
}

QFrame#dashboardMetricChip,
QFrame#dashboardChartPanel {
    background-color: rgba(255, 255, 255, 248);
    border: 1px solid rgba(154, 179, 230, 220);
    border-radius: ${radius_lg}px;
}

QFrame#dashboardChartPanel[hovered="true"] {
    background-color: rgba(255, 255, 255, 255);
    border: 1px solid rgba(154, 179, 230, 230);
}

QFrame#dashboardMetricChip {
    background-color: rgba(255, 255, 255, 252);
}

QFrame#dashboardCardIconShell {
    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
    background-color: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(154, 179, 230, 0.95);
    border-radius: 19px;
}

QLabel#dashboardMetricValue {
    color: #05095C;
    font-size: 28px;
    font-weight: 800;
}

QLabel#dashboardMetricTitle {
    color: #8F8F8F;
    font-size: 12px;
    font-weight: 700;
}

QLabel#dashboardChartTitle {
    color: #05095C;
    font-size: 18px;
    font-weight: 800;
}

QFrame#dashboardChartPanel[hovered="true"] QLabel#dashboardChartTitle {
    color: #05095C;
}

QLabel#dashboardChartSubtitle {
    color: #8F8F8F;
    font-size: 13px;
}

QFrame#dashboardChartPanel[hovered="true"] QLabel#dashboardChartSubtitle {
    color: #05095C;
}

QWidget#dashboardBarChart {
    background-color: transparent;
}

QFrame#dashboardProfile,
QFrame#dashboardStatus {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: ${radius_lg}px;
}

QLabel#dashboardProfileAvatar {
    background-color: rgba(255, 255, 255, 124);
    border: 1px solid rgba(255, 255, 255, 184);
    border-radius: ${radius_lg}px;
    padding: 10px;
}

QLabel#dashboardProfileTitle,
QLabel#dashboardSideTitle,
QLabel#dashboardStatusTitle {
    color: #FFFFFF;
    font-size: 15px;
    font-weight: 800;
}

QLabel#dashboardProfileSubtitle,
QLabel#dashboardStatusText {
    color: rgba(255, 255, 255, 0.72);
    font-size: 13px;
}

QLabel#dashboardStatusTag {
    color: rgba(255, 255, 255, 0.56);
    font-size: 12px;
    font-weight: 700;
}

QPushButton#dashboardQuickButton {
    background-color: rgba(255, 255, 255, 0);
    color: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(255, 255, 255, 0);
    border-radius: ${radius_md}px;
    text-align: left;
    padding: 12px 12px;
    font-weight: 700;
}

QPushButton#dashboardQuickButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.06);
}

