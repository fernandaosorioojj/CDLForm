QWidget#reportesView {
    background-color: #FFFFFF;
}

QWidget#reportesView QFrame#reportesTopPanel {
    background-color: #05095C;
    border: 1px solid rgba(5, 9, 92, 220);
    border-radius: 18px;
}

QWidget#reportesView QFrame#reportesHeader {
    background-color: transparent;
    border: none;
}

QWidget#reportesView QFrame#reportesHeader QLabel[role="title"] {
    color: #FFFFFF;
    font-size: 30px;
}

QWidget#reportesView QFrame#reportesHeader QLabel[role="subtitle"] {
    color: rgba(255, 255, 255, 0.72);
    font-size: 15px;
}

QWidget#reportesView QFrame#reportesHeader QLabel[role="eyebrow"] {
    color: rgba(255, 255, 255, 0.56);
}

QWidget#reportesView QFrame#reportesFiltros,
QWidget#reportesView QFrame#reportesTablaPanel {
    background-color: rgba(255, 255, 255, 244);
    border: 1px solid rgba(154, 179, 230, 232);
    border-radius: 18px;
}

QWidget#reportesView QFrame[card="true"] {
    padding: 12px;
}

QWidget#reportesView QLineEdit,
QWidget#reportesView QComboBox {
    min-height: 22px;
}

QWidget#reportesView QPushButton {
    background-color: #05095C;
    color: #FFFFFF;
    border: 1px solid #05095C;
}

QWidget#reportesView QPushButton:hover {
    background-color: #05095C;
    border: 1px solid #05095C;
}

QWidget#reportesView QPushButton[variant="secondary"] {
    background-color: #9AB3E6;
    color: #05095C;
    border: 1px solid rgba(154, 179, 230, 0.95);
}

QWidget#reportesView QPushButton[variant="secondary"]:hover {
    background-color: #FFFFFF;
    border: 1px solid rgba(154, 179, 230, 1);
}

QWidget#reportesView QTableWidget {
    background-color: rgba(255, 255, 255, 252);
    border: 1px solid rgba(154, 179, 230, 220);
    border-radius: 14px;
}

QWidget#reportesView QHeaderView::section {
    background-color: #9AB3E6;
    color: #05095C;
    border-bottom: 1px solid rgba(154, 179, 230, 0.95);
    padding: 10px 8px;
}

QWidget#reportesView QTableWidget::item:hover {
    background-color: #FFFFFF;
}

